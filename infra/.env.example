# Copy to a local .env only after the team confirms service addresses.
GROBID_URL=http://localhost:8070
ELASTICSEARCH_URL=http://127.0.0.1:9200
ELASTICSEARCH_INDEX=scholarlens-papers-real
# Optional TLS/auth settings. Set environment variables in PowerShell; no automatic .env load.
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_CA_CERTS=
# PDF access defaults to disabled. Set actual local paths only in your private .env/shell.
SCHOLARLENS_PDF_ROOT=
# Optional base for stored relative pdf_path; default is project root.
SCHOLARLENS_PDF_PATH_BASE=
# Local delivered JSONL/XML directory for explicit quality/test CLI commands.
SCHOLARLENS_REAL_DATA_DIR=
# V2 private runtime: SQLite, isolated uploads, evaluation and model assets (Git ignored).
SCHOLARLENS_RUNTIME_DIR=backend/.runtime
VECTOR_INDEX=scholarlens-vectors-real
UPLOADS_INDEX=scholarlens-uploads-real
UPLOAD_VECTOR_INDEX=scholarlens-vectors-uploads-real
EMBEDDING_MODEL_DIR=backend/.runtime/minilm
# Explicit CSV paper_id/source_file/pdf_sha256 for moving PDFs into a flat PDF root.
SCHOLARLENS_PDF_MANIFEST=
# Comma-separated exact React development origins. Prefer Vite proxy; no wildcard.
CORS_ORIGINS=
# Empty credentials intentionally: server only, never returned by API or logs.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=800
AI_TOKEN_PARAMETER=max_completion_tokens
EMAIL_BASE_URL=
EMAIL_API_KEY=
# Optional same-origin production frontend; set an absolute built dist path.
FRONTEND_DIST=
