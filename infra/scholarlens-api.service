[Unit]
Description=ScholarLens API and production frontend
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=scholarlens
Group=scholarlens
WorkingDirectory=/opt/scholarlens/current
EnvironmentFile=/etc/scholarlens/app.env
Environment=OMP_NUM_THREADS=1
Environment=TOKENIZERS_PARALLELISM=false
ExecStart=/opt/scholarlens/venv/bin/python -m uvicorn backend.app1:app --host 127.0.0.1 --port 18090 --workers 1 --no-access-log
Restart=on-failure
RestartSec=5
MemoryHigh=400M
MemoryMax=600M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/scholarlens
UMask=0077

[Install]
WantedBy=multi-user.target
